---
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

import IconBrandFacebook from "@tabler/icons/outline/brand-facebook.svg";
import IconBrandInstagram from "@tabler/icons/outline/brand-instagram.svg";
import IconSoup from "@tabler/icons/outline/soup.svg";

export interface SocialLink {
  name: string;
  href: string;
  icon: any;
}

interface Props extends HTMLAttributes<"footer"> {
  socialLinks?: SocialLink[];
  companyName?: string;
}

const footerStyles = tv({
  base: "bg-muted/30 border-t",
});

const {
  socialLinks = [
    { name: "Facebook", href: "https://facebook.com", icon: IconBrandFacebook },
    { name: "Instagram", href: "https://instagram.com", icon: IconBrandInstagram }
  ],
  companyName = "FoodStore",
  class: className,
  ...rest
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class={footerStyles({ class: className })} {...rest}>
  <div class="mx-auto w-full max-w-7xl px-4 py-16">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      {/* Brand */}
      <div class="space-y-4">
        <div class="flex items-center gap-2 text-2xl font-bold text-foreground">
          <IconSoup class="size-6 text-primary" />
          {companyName}
        </div>
        <p class="text-sm text-muted-foreground">
          Thức ăn tuyệt ngon, đến tận nhà. Nguyên liệu tươi ngon, giao hàng siêu tốc.
        </p>
        <div class="flex gap-4">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="size-10 rounded-lg bg-muted flex items-center justify-center text-muted-foreground hover:text-foreground hover:bg-muted/80 transition-colors"
                aria-label={social.name}
              >
                <social.icon class="size-5" aria-hidden="true" />
              </a>
            ))
          }
        </div>
      </div>

      {/* Quick Links */}
      <div>
        <h3 class="font-semibold text-foreground mb-4">Liên kết nhanh</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="#about" class="text-muted-foreground hover:text-foreground transition-colors">Về chúng tôi</a></li>
          <li><a href="#menu" class="text-muted-foreground hover:text-foreground transition-colors">Thực đơn</a></li>
          <li><a href="#specials" class="text-muted-foreground hover:text-foreground transition-colors">Ưu đãi</a></li>
          <li><a href="#contact" class="text-muted-foreground hover:text-foreground transition-colors">Liên hệ</a></li>
        </ul>
      </div>

      {/* Contact */}
      <div>
        <h3 class="font-semibold text-foreground mb-4">Liên hệ</h3>
        <ul class="space-y-3 text-sm">
          <li class="flex gap-2">
            <svg class="size-5 text-muted-foreground flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span class="text-muted-foreground">123 Đường ABC, Quận 1, TP.HCM</span>
          </li>
          <li class="flex gap-2">
            <svg class="size-5 text-muted-foreground flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <a href="tel:1900123456" class="text-muted-foreground hover:text-foreground transition-colors">1900 1234 56</a>
          </li>
          <li class="flex gap-2">
            <svg class="size-5 text-muted-foreground flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="text-muted-foreground">T2-T6: 7:00-22:00 | T7-CN: 8:00-23:00</span>
          </li>
        </ul>
      </div>

      {/* Parking */}
      <div>
        <h3 class="font-semibold text-foreground mb-4">Tiện ích</h3>
        <ul class="space-y-2 text-sm text-muted-foreground">
          <li class="flex items-center gap-2">
            <svg class="size-4 text-primary" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            Bãi đậu xe miễn phí
          </li>
          <li class="flex items-center gap-2">
            <svg class="size-4 text-primary" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            WiFi miễn phí
          </li>
          <li class="flex items-center gap-2">
            <svg class="size-4 text-primary" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            Chấp nhận thẻ/tiền mặt
          </li>
        </ul>
      </div>
    </div>

    {/* Copyright */}
    <div class="mt-8 pt-6 border-t text-center text-sm text-muted-foreground">
      © {currentYear} {companyName}. All rights reserved.
    </div>
  </div>
</footer>
