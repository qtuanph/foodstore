---
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

import { Badge } from "@/components/starwind/badge";

import IconLeaf from "@tabler/icons/outline/leaf.svg";
import IconChefHat from "@tabler/icons/outline/chef-hat.svg";
import IconTruck from "@tabler/icons/outline/truck.svg";
import IconClock from "@tabler/icons/outline/clock.svg";
import IconStar from "@tabler/icons/outline/star.svg";
import IconHeart from "@tabler/icons/outline/heart.svg";

export interface FeatureCard {
  icon: any;
  title: string;
  description: string;
  stat?: string;
}

interface Props extends HTMLAttributes<"section"> {
  title?: string;
  description?: string;
  features?: FeatureCard[];
}

const sectionStyles = tv({
  base: "@container mx-auto w-full max-w-7xl px-4 py-24",
});

const {
  title = "Tại sao chọn FoodStore?",
  description = "Chúng tôi cam kết mang đến những bữa ăn chất lượng nhất với dịch vụ tốt nhất.",
  features = [
    {
      icon: IconLeaf,
      title: "Nguyên liệu tươi 100%",
      description: "Tuyển chọn từ trang trại uy tín, không chất bảo quản, luôn tươi ngon mỗi ngày.",
      stat: "100%"
    },
    {
      icon: IconChefHat,
      title: "Đầu bếp quốc tế",
      description: "15+ năm kinh nghiệm, đào tạo từ trường ẩm thực hàng đầu thế giới.",
      stat: "15+ năm"
    },
    {
      icon: IconTruck,
      title: "Giao hàng 30 phút",
      description: "Giao hàng trong 30 phút hoặc miễn phí. Hotline hỗ trợ 24/7.",
      stat: "30 phút"
    },
    {
      icon: IconClock,
      title: "Phục vụ 24/7",
      description: "Đội ngũ shipper chuyên nghiệp, luôn đúng giờ và nhiệt tình.",
      stat: "24/7"
    },
    {
      icon: IconStar,
      title: "Đánh giá 4.8/5",
      description: "Hơn 200+ review trên Google với điểm đánh giá 4.8/5.",
      stat: "4.8/5"
    },
    {
      icon: IconHeart,
      title: "12,500+ khách hàng",
      description: "Phục vụ hơn 12,500 khách hàng mỗi tháng trên toàn quốc.",
      stat: "12,500+"
    }
  ],
  class: className,
  ...rest
} = Astro.props;
---

<section class={sectionStyles({ class: className })} {...rest}>
  <div class="mb-16 text-center">
    <Badge variant="secondary" class="mb-4">Ưu điểm</Badge>
    <h2 class="font-heading mb-4 text-3xl font-bold tracking-tight @xl:text-4xl @3xl:text-5xl">
      {title}
    </h2>
    <p class="text-muted-foreground mx-auto max-w-2xl text-pretty @lg:text-lg">
      {description}
    </p>
  </div>

  <div class="grid gap-8 @lg:grid-cols-2 @3xl:grid-cols-3 @3xl:gap-12">
    {
      features.map((feature) => (
        <div class="flex gap-4">
          <div class="flex-shrink-0">
            <div class="size-12 rounded-xl bg-primary/10 flex items-center justify-center">
              <feature.icon class="size-6 text-primary" aria-hidden="true" />
            </div>
          </div>
          <div>
            <div class="flex items-center gap-2 mb-1">
              <h3 class="font-semibold text-foreground">{feature.title}</h3>
              {feature.stat && (
                <span class="text-xs font-medium text-primary bg-primary/10 px-2 py-0.5 rounded-full">
                  {feature.stat}
                </span>
              )}
            </div>
            <p class="text-sm text-muted-foreground leading-relaxed">
              {feature.description}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>
