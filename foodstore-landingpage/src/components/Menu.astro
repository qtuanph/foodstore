---
import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import { getMenu } from "@/lib/api";

const menuRes = await getMenu();
const categories = menuRes?.data || [];
---

<section id="menu" class="py-24 bg-muted/30">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 space-y-4">
      <Badge variant="secondary">Thực đơn</Badge>
      <h2 class="text-4xl md:text-5xl font-bold text-foreground">
        Thực đơn của chúng tôi
      </h2>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
        Khám phá thực đơn đa dạng với những món ăn được chế biến từ nguyên liệu tươi ngon mỗi ngày.
      </p>
    </div>

    {categories.length > 0 ? (
      <div class="space-y-16">
        {categories.map((category) => (
          <div>
            <div class="flex items-center gap-3 mb-8">
              <h3 class="text-2xl font-bold text-foreground">{category.name}</h3>
              <div class="flex-1 h-px bg-border"></div>
              <span class="text-sm text-muted-foreground">{category.items.length} món</span>
            </div>
            
            <div class="grid md:grid-cols-2 gap-4">
              {category.items.map((item) => (
                <div class="flex gap-4 bg-background rounded-xl p-4 hover:shadow-lg transition-shadow">
                  {item.imageUrl && (
                    <div class="w-24 h-24 rounded-lg overflow-hidden flex-shrink-0">
                      <img src={item.imageUrl} alt={item.name} class="size-full object-cover" loading="lazy" />
                    </div>
                  )}
                  <div class="flex-1 min-w-0">
                    <div class="flex items-start justify-between gap-2">
                      <div class="min-w-0">
                        <h4 class="font-semibold text-foreground">{item.name}</h4>
                        {item.description && (
                          <p class="text-sm text-muted-foreground line-clamp-2 mt-1">{item.description}</p>
                        )}
                      </div>
                      <span class="text-lg font-bold text-primary whitespace-nowrap">
                        {new Intl.NumberFormat('vi-VN').format(item.price)}đ
                      </span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-12">
        <p class="text-muted-foreground">Thực đơn đang được cập nhật...</p>
      </div>
    )}

    <div class="text-center mt-12">
      <Button variant="outline" size="lg" href="#contact">
        Liên hệ đặt bàn
        <svg class="size-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </Button>
    </div>
  </div>
</section>
